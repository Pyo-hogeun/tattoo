PORT=4000
MONGODB_URI=mongodb://localhost:27017/eyebrow_backoffice
SCRAPE_CRON=*/10 * * * *
SCRAPE_TIMEOUT_MS=10000
FRONTEND_ORIGIN=http://localhost:3000
FRONTEND_ORIGIN_USER=http://localhost:3001

# 충분히 긴 임의 문자열로 교체하세요. 운영 환경에서 기본값을 사용하면 안 됩니다.
JWT_SECRET=replace_with_a_long_random_secret

# 프론트와 동일한 카카오 REST API 키를 입력합니다.
KAKAO_CLIENT_ID=your_kakao_rest_api_key
KAKAO_REDIRECT_URI=http://localhost:3000/auth/kakao/callback

# 카카오 개발자 콘솔에서 Client Secret을 활성화한 경우에만 해당 코드를 입력합니다.
# 활성화하지 않았다면 반드시 빈 값으로 두세요. REST API 키나 Admin 키를 넣으면 안 됩니다.
KAKAO_CLIENT_SECRET=

# Cloudflare R2: /brow-shapes/manage 및 manager 갤러리가 같은 버킷을 사용합니다.
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY=your_r2_access_key
R2_SECRET_KEY=your_r2_secret_key
R2_BUCKET=your_r2_bucket
R2_PUBLIC_URL=https://your-public-r2-domain.example.com
