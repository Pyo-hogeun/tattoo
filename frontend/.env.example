# 카카오 개발자 콘솔 > 앱 > 앱 키에 표시되는 REST API 키
NUXT_PUBLIC_KAKAO_CLIENT_ID=your_kakao_rest_api_key

# 카카오 개발자 콘솔에 등록한 Redirect URI와 글자 단위로 같아야 합니다.
NUXT_PUBLIC_KAKAO_REDIRECT_URI=http://localhost:3000/auth/kakao/callback
# 일반 사용자 프론트엔드가 사용하는 별도 Redirect URI
NUXT_PUBLIC_KAKAO_USER_REDIRECT_URI=http://localhost:3001/auth/kakao/callback

# 브라우저에서 접근할 백엔드 API 주소
NUXT_PUBLIC_API_BASE=http://localhost:4000/api
NUXT_PUBLIC_ENABLE_TEST_AUTH=false
